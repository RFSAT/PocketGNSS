<resources>
    <!-- Edge-to-edge as in PocketSpectro: transparent system bars from the theme, insets applied by Compose. -->
    <style name="Theme.PocketGNSS" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="bg">#FF121416</color>
</resources>
